{
  "defaults": {
    "humanOnly": [".github/**", "**/.env*", "**/Dockerfile*", "**/infra/**", "**/auth/**", "**/*billing*", "**/*payment*"]
  },
  "repos": {
    "your-name/your-repo": {
      "humanOnly": ["db/migrations/**"],
      "requireHumanApprovalOnHead": false,
      "mergeCommitBranches": ["sync/*"]
    },
    "your-org/*": {
      "requireHumanApprovalOnHead": true
    }
  }
}
